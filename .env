import { getRankImageSrc } from '../utils/dom.js'; // インポートに追加
import { getVideoIcon, isModalVideoIcon } from '../ui/videoModal.js'; // isModalVideoIcon をインポート

// ... renderRankingList 関数内 ...

// モーダル判定の修正
// 修正前: const isModalTarget = (iconSrc === 'Youtube.webp' || iconSrc === 'Discord.webp' || iconSrc === 'Filenow.webp');
const isModalTarget = isModalVideoIcon(iconSrc);

// ランク画像の修正
if (d.rank <= 8) {
  rankContent = `<img src="${getRankImageSrc(d.rank)}" onerror="this.style.display='none';this.parentElement.innerText='${d.rank}'">`;
} else {
  rankContent = `<span style="font-size:1.5rem;font-weight:bold;">${d.rank}</span>`;
}

// 国旗画像の拡張子修正（scotland.webp に合わせる）
if (d.country && d.country !== '-') {
  const countryCode = d.country.toLowerCase();
  flagHtml = `<img src="${countryCode === 'scotland' ? 'img/flag/scotland.webp' : `${FLAG_BASE_URL}${countryCode}.webp`}" onerror="this.style.visibility='hidden'">`;
}
