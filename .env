# このファイルを .env にコピーして、APIキーを記入してください。
# .env は他人に渡さない / GitHub等にアップロードしないこと。
GOOGLE_VISION_API_KEY=

# ── 以下は任意 (先頭の # を外して変更) ──
# 月間の上限ユニット数 (既定 1000)
# MK7_MONTHLY_LIMIT=1000
# OCRの種類 (TEXT_DETECTION / DOCUMENT_TEXT_DETECTION)
# MK7_OCR_FEATURE=TEXT_DETECTION
# MK7_OCR_HINTS=ja,en

# 読み取り行数の期待値。これと違うと確認画面に警告を出す (0で警告なし)
# MK7_EXPECTED_ROWS=8

# window_half モードの切り抜き範囲 (クライアント領域に対する 0〜1 の比率)
# 画像から割り出すには calibrate_crop.py を使う。アプリを再起動しなくても反映される。
# MK7_CROP_LEFT=0.245
# MK7_CROP_TOP=0.570
# MK7_CROP_RIGHT=0.612
# MK7_CROP_BOTTOM=0.930

# 調査用: 送信した画像とVisionの応答、切り抜き前の画像(last_client.png)を保存する
# MK7_OCR_DEBUG_DIR=C:\Users\あなた\Downloads\ScoreApp\ocr_debug

# 利用量DBの場所 (通常は変更不要)
# MK7_USAGE_DB=C:\Users\あなた\AppData\Local\MK7ScoreOCR\usage.db
